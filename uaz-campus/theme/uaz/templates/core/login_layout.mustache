{{!
    @template theme_uaz/core/login_layout

    Les pages de connexion de UAZ Campus, dans la composition de celle du
    registrar (registrar.zurcher.edu.mg/login) : un cadre qui tient deux
    panneaux, l'encart de marque a gauche, sous un ciel etoile, et le
    formulaire a droite. Sur un ecran etroit, l'encart laisse la place au
    formulaire et son en-tete passe au-dessus.

    L'encart ne porte rien dont le formulaire ait besoin : il est retire de
    l'arbre d'accessibilite, comme celui du registrar.

    Example context (json):
    {
        "output": {
            "main_content": "<div class='loginform'>Formulaire</div>"
        }
    }
}}
<div id="page-content" class="uaz-connexion">
    <aside class="uaz-marque" aria-hidden="true">
        <div class="uaz-ciel" data-ciel="0.7"></div>
        <div class="uaz-marque__contenu">
            <div class="uaz-marque__tete">
                <span class="uaz-sceau"></span>
                <div>
                    <p class="uaz-marque__nom">{{#str}}nomcampus, theme_uaz{{/str}}</p>
                    <p class="uaz-marque__universite">{{#str}}universite, theme_uaz{{/str}}</p>
                </div>
            </div>
            <div class="uaz-marque__texte">
                <h2 class="uaz-marque__accroche">{{#str}}accroche, theme_uaz{{/str}}</h2>
                <p class="uaz-marque__presentation">{{#str}}presentation, theme_uaz{{/str}}</p>
                <ul class="uaz-atouts">
                    <li>
                        <span class="uaz-atout__puce">
                            <svg viewBox="0 0 24 24"><path d="M2 4h6a4 4 0 0 1 4 4v13a3 3 0 0 0-3-3H2z"/><path d="M22 4h-6a4 4 0 0 0-4 4v13a3 3 0 0 1 3-3h7z"/></svg>
                        </span>
                        <div><strong>{{#str}}atout1titre, theme_uaz{{/str}}</strong><span>{{#str}}atout1texte, theme_uaz{{/str}}</span></div>
                    </li>
                    <li>
                        <span class="uaz-atout__puce">
                            <svg viewBox="0 0 24 24"><path d="M9 4h6v3H9z"/><path d="M15 5h3a1 1 0 0 1 1 1v14a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1h3"/><path d="m9 14 2 2 4-4.5"/></svg>
                        </span>
                        <div><strong>{{#str}}atout2titre, theme_uaz{{/str}}</strong><span>{{#str}}atout2texte, theme_uaz{{/str}}</span></div>
                    </li>
                    <li>
                        <span class="uaz-atout__puce">
                            <svg viewBox="0 0 24 24"><path d="M12 3 5.3 6v6c0 4 2.3 7.1 6.7 8.7 4.4-1.6 6.7-4.7 6.7-8.7V6z"/><path d="m9.4 12.2 1.9 1.9 3.4-3.6"/></svg>
                        </span>
                        <div><strong>{{#str}}atout3titre, theme_uaz{{/str}}</strong><span>{{#str}}atout3texte, theme_uaz{{/str}}</span></div>
                    </li>
                </ul>
            </div>
            <p class="uaz-marque__pied">© {{#str}}pied, theme_uaz{{/str}}</p>
        </div>
    </aside>
    <div id="region-main" class="uaz-acces">
        <div class="uaz-acces__marque">
            <span class="uaz-sceau"></span>
            <p class="uaz-marque__nom">{{#str}}nomcampus, theme_uaz{{/str}}</p>
            <p class="uaz-marque__universite">{{#str}}universite, theme_uaz{{/str}}</p>
        </div>
        <div id="region-main-box" class="uaz-acces__carte">
            {{{ output.main_content }}}
        </div>
    </div>
</div>
{{#js}}
    // Le ciel du registrar (src/js/ciel.js) : trois couches d'etoiles qui montent,
    // de la plus fine et nombreuse a la plus grosse et rare ; une sur douze prend
    // l'or du sceau. Les couches sont dessinees en box-shadow (scss/uaz.scss).
    document.querySelectorAll('[data-ciel]').forEach(function(ciel) {
        if (ciel.getAttribute('data-ciel-pret')) {
            return;
        }
        ciel.setAttribute('data-ciel-pret', '1');
        var largeur = Math.max(ciel.clientWidth || 0, 600);
        var densite = parseFloat(ciel.getAttribute('data-ciel')) || 1;
        [[700, 1], [200, 2], [100, 3]].forEach(function(c) {
            var etoiles = [];
            var nombre = Math.round(c[0] * densite * largeur / 2000);
            for (var i = 0; i < nombre; i++) {
                var couleur = Math.random() < 0.08 ? 'rgba(206, 180, 128, .9)'
                    : 'rgba(255, 255, 255, ' + (0.45 + Math.random() * 0.55).toFixed(2) + ')';
                etoiles.push(Math.round(Math.random() * largeur) + 'px ' + Math.round(Math.random() * 2000) + 'px ' + couleur);
            }
            var couche = document.createElement('div');
            couche.className = 'uaz-ciel__couche uaz-ciel__couche--' + c[1];
            couche.style.setProperty('--etoiles', etoiles.join(', '));
            ciel.appendChild(couche);
        });
    });
{{/js}}

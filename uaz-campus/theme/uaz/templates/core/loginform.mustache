{{!
    @template theme_uaz/core/loginform

    Le formulaire de connexion de UAZ Campus : celui de Moodle 5.3
    (lib/templates/loginform.mustache), dans l'ordre et le style de la page
    du registrar. Les comptes des etudiants et des enseignants naissent a leur
    premiere connexion Google (@zurcher.edu.mg) et n'ont pas de mot de passe
    Moodle : le bouton Google passe donc en tete, l'identifiant (administrateurs)
    vient ensuite. Le reste est celui de Moodle, scripts compris (bascule du mot
    de passe, envoi, focus) : a reprendre si Moodle change son gabarit.

    Context variables required for this template:
    * autofocusform: Auto focus on form ?,
    * canloginasguest - Is guest login allowed?,
    * canloginbyemail - Is login by email allowed?,
    * cansignup - Signup allowed?,
    * showloginform - Hide the standard login form if it not necessary (only OAuth2 for example)
    * error - Any errors in the form?,
    * errortitle - Optional bold heading shown above the error message (credential failures only),
    * hasauthinstructions - Flag, set to true when auth_instructions is configured,
    * info - Info notification to display,
    * forgotpasswordurl - Forgot password url,
    * hasidentityproviders - Flag, set to true to hide identity providers,
    * identityproviders - List of identity providers,
    * instructions - Instructions,
    * loginurl - Login url,
    * signupurl - Signup url,
    * logourl - Flag, logo url,
    * sitename - Name of site.,
    * logintoken - Random token to protect login request.,
    * maintenance - Maintenance message,
    * hasoauth2client - Flag, set when this login form is part of an OAuth2 authorization flow,
    * client - The requesting OAuth2 client, if hasoauth2client is true
      * name - The client's name,
      * description - The client's description, as formatted HTML.

    Example context (json):
    {
        "autofocusform": false,
        "canloginasguest": "1",
        "canloginbyemail": false,
        "cansignup": true,
        "showloginform": true,
        "error": "",
        "errortitle": "",
        "hasauthinstructions": false,
        "info": "",
        "forgotpasswordurl": "http://localhost/stable_master/login/forgot_password.php",
        "hasidentityproviders": false,
        "identityproviders": [],
        "instructions": "For full access to this site, you first need to create an account.",
        "loginurl": "http://localhost/stable_master/login/index.php",
        "signupurl": "http://localhost/stable_master/login/signup.php",
        "logourl": false,
        "sitename": "Beer & Chips",
        "logintoken": "randomstring",
        "maintenance": "For full access to this site, you need to login in as an admin.",
        "languagemenu": "Choose language",
        "togglepassword": true,
        "smallscreensonly": true,
        "hasoauth2client": false
    }
}}

<div class="loginform">
    <h1 class="uaz-titre">{{#str}}titreconnexion, theme_uaz{{/str}}</h1>
    <p class="uaz-soustitre">{{#str}}soustitre, theme_uaz{{/str}}</p>
    {{#hasoauth2client}}
        <h2 class="login-heading">{{#str}}oauth2:confirmscopes:clientaccesstitle, moodle, {
            "clientname": {{#quote}}{{client.name}}{{/quote}},
            "clientdescription": {{#quote}}{{client.description}}{{/quote}},
            "sitename": {{#quote}}{{sitename}}{{/quote}}
        }{{/str}}</h2>
        {{> core/oauth2/client_description}}
    {{/hasoauth2client}}
    {{#maintenance}}
        <div class="alert alert-danger login-maintenance">
            {{{maintenance}}}
        </div>
    {{/maintenance}}
    {{#error}}
        <div class="alert alert-danger" id="loginerrormessage" role="alert">
            {{#errortitle}}<strong class="d-block mb-1">{{errortitle}}</strong>{{/errortitle}}
            {{error}}
        </div>
    {{/error}}
    {{#info}}
        <div class="alert alert-info" id="logininfomessage" role="status">{{info}}</div>
    {{/info}}
    {{#hasidentityproviders}}
        <div class="login-identityproviders">
            {{#identityproviders}}
                <a class="btn login-identityprovider-btn uaz-fournisseur" href="{{url}}">
                    {{#iconurl}}
                        <img src="{{iconurl}}" alt="" width="20" height="20"/>
                    {{/iconurl}}
                    {{#str}}loginwith, core, {{name}}{{/str}}
                </a>
            {{/identityproviders}}
        </div>
        <p class="uaz-info-google">{{#str}}googleinfo, theme_uaz{{/str}}</p>
        {{#showloginform}}
            <div class="login-separator uaz-separateur">{{#str}}ouidentifiant, theme_uaz{{/str}}</div>
        {{/showloginform}}
    {{/hasidentityproviders}}
    {{#showloginform}}
        <form class="login-form" action="{{loginurl}}" method="post" id="login">
            <input id="anchor" type="hidden" name="anchor" value="">
            <script>document.getElementById('anchor').value = location.hash;</script>
            <input type="hidden" name="logintoken" value="{{logintoken}}">
            <div class="login-form-username mb-3">
                <label for="username" class="form-label">
                    {{^canloginbyemail}}
                        {{#str}} username {{/str}}
                    {{/canloginbyemail}}
                    {{#canloginbyemail}}
                        {{#str}} usernameemail {{/str}}
                    {{/canloginbyemail}}
                </label>
                <input
                    type="text"
                    name="username"
                    id="username"
                    class="form-control"
                    value="{{username}}"
                    placeholder="{{#str}}indicationidentifiant, theme_uaz{{/str}}"
                    autocomplete="username"
                >
            </div>
            <div class="login-form-password mb-2">
                <label for="password" class="form-label">{{#str}} password {{/str}}</label>
                <input
                    type="password"
                    name="password"
                    id="password"
                    value=""
                    class="form-control"
                    placeholder="{{#str}}indicationmotdepasse, theme_uaz{{/str}}"
                    autocomplete="current-password"
                >
            </div>
            <div class="uaz-oubli mb-3">
                <a href="{{forgotpasswordurl}}">{{#str}}loginforgotpassword{{/str}}</a>
            </div>
            {{#recaptcha}}
                <div class="login-form-recaptcha mb-3">
                    {{{recaptcha}}}
                </div>
            {{/recaptcha}}
            <div class="login-form-submit mb-3">
                <button class="btn btn-primary w-100 uaz-envoyer" type="submit" id="loginbtn">{{#str}}login{{/str}}</button>
            </div>
        </form>
    {{/showloginform}}
    {{#hasauthinstructions}}
        <div class="d-lg-none small mb-3">
            {{{instructions}}}
        </div>
    {{/hasauthinstructions}}
    {{^hasauthinstructions}}
        {{#cansignup}}
            <div class="text-center small mb-3">
                {{#instructions}}
                    <span class="text-muted me-1">{{{instructions}}}</span>
                {{/instructions}}
                <a href="{{signupurl}}">{{#str}}loginstartsignup{{/str}}</a>
            </div>
        {{/cansignup}}
        {{^cansignup}}
            {{#instructions}}
                <p class="small mb-3">{{{instructions}}}</p>
            {{/instructions}}
        {{/cansignup}}
    {{/hasauthinstructions}}
    {{#hasauthinstructions}}
        {{#cansignup}}
            <div class="text-center small mb-3">
                <a href="{{signupurl}}">{{#str}}loginstartsignup{{/str}}</a>
            </div>
        {{/cansignup}}
    {{/hasauthinstructions}}
    {{^hasidentityproviders}}
        {{#canloginasguest}}
            <div class="login-separator my-4">{{#str}}loginseparatoror{{/str}}</div>
        {{/canloginasguest}}
    {{/hasidentityproviders}}
    {{#canloginasguest}}
        <form action="{{loginurl}}" method="post" id="guestlogin" class="mb-4">
            <input type="hidden" name="logintoken" value="{{logintoken}}">
            <input type="hidden" name="username" value="guest" />
            <input type="hidden" name="password" value="guest" />
            <button class="btn btn-outline-secondary login-identityprovider-btn" type="submit" id="loginguestbtn"><i class="fa fa-user me-2" aria-hidden="true"></i>{{#str}}loginasguest{{/str}}</button>
        </form>
    {{/canloginasguest}}
    {{#languagemenu}}
        <div class="login-languagemenu d-flex justify-content-center my-5">
            {{>core/action_menu}}
        </div>
    {{/languagemenu}}
    <div class="login-cookiesnotice text-center">
        <button type="button" class="btn btn-link p-0" {{!
        }} data-modal="alert"{{!
        }} data-modal-title-str='["cookiesenabled", "core"]' {{!
        }} data-modal-content-str='["cookiesenabled_help_html", "core"]'{{!
        }}>{{#str}}cookiesnotice{{/str}}</button>
    </div>
</div>

{{#js}}
    {{^error}}
        {{#autofocusform}}
            require(['core_form/events'], function(FormEvent) {
                function autoFocus() {
                    const userNameField = document.getElementById('username');
                    const passwordField = document.getElementById('password');
                    if (userNameField && userNameField.value.length == 0) {
                        userNameField.focus();
                    } else if (passwordField) {
                        passwordField.focus();
                    }
                }
                autoFocus();
                window.addEventListener(FormEvent.eventTypes.fieldStructureChanged, autoFocus);
            });
        {{/autofocusform}}
    {{/error}}
    require(['core/pending'], function(Pending) {
        const errorMessageDiv = document.getElementById('loginerrormessage');
        const infoMessageDiv = document.getElementById('logininfomessage');
        const errorMessage = errorMessageDiv?.textContent.trim();
        const infoMessage = infoMessageDiv?.textContent.trim();
        if (errorMessage || infoMessage) {
            const pendingJS = new Pending('login-move-focus');
            const usernameField = document.getElementById('username');
            setTimeout(function() {
                if (errorMessage && usernameField) {
                    usernameField.focus();
                }
                if (errorMessage) {
                    errorMessageDiv.innerHTML += "&nbsp;";
                }
                if (infoMessage) {
                    infoMessageDiv.innerHTML += "&nbsp;";
                }
                pendingJS.resolve();
            }, 500);
        }
    });
    {{#togglepassword}}
        require(['core/togglesensitive'], function(ToggleSensitive) {
            ToggleSensitive.init("password", {{smallscreensonly}});
        });
    {{/togglepassword}}
    require(['core_form/submit'], function(Submit) {
        Submit.init("loginbtn");
        {{#canloginasguest}}
            Submit.init("loginguestbtn");
        {{/canloginasguest}}
    });
{{/js}}

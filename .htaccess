RewriteEngine On

# ============================================================================
# ARCHITECTURE MVC - Infinit Registrar
# ============================================================================
# Toutes les requêtes passent par index.php (Front Controller)
# sauf les fichiers statiques et les anciens chemins (compatibilité arrière)
# ============================================================================

# Redirection HTTP vers HTTPS (nécessaire pour la géolocalisation GPS)
RewriteCond %{HTTPS} !=on
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# Désactiver l'ajout automatique de slash pour les dossiers
<IfModule mod_dir.c>
    DirectorySlash Off
</IfModule>

# Désactiver l'affichage du contenu des dossiers
Options -Indexes

# Supprimer le trailing slash (redirection 301, sauf racine)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_URI} ^(.+)/$
RewriteRule ^(.+)/$ $1 [R=301,L,QSA]

# Masquer l'extension .php dans les URLs (redirection 301)
RewriteCond %{THE_REQUEST} \s/+(.*/)?([^/.]+)\.php[\s?] [NC]
RewriteRule ^ %1%2 [R=301,L,NE]

# Servir les fichiers statiques directement (CSS, JS, images, fonts, etc.)
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -l
RewriteRule ^ - [L]

# Compatibilité arrière: servir les .php sans extension pour les anciens chemins
# Fonctionne pour src/, app/, landing/, inscription/, data/, verifier/, etc.
# Ne s'applique que si le fichier .php correspondant existe réellement
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^(.+)$ $1.php [L,QSA]

# ============================================================================
# FRONT CONTROLLER MVC
# Toutes les requêtes non résolues sont routées vers index.php
# ============================================================================
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ index.php [QSA,L]

RewriteEngine On

# Les règles de réécriture sont gérées par le .htaccess racine (MVC)
# Ce fichier est conservé pour compatibilité mais les règles principales
# (masquage .php, redirection) sont dans le .htaccess parent.

# Servir les fichiers .php sans l'extension (compatibilité arrière)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^(.*)$ $1.php [L]
